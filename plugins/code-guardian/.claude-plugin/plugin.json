{
  "$schema": "https://agent-plugins.org/schema/1.0.0/plugin.json",
  "name": "code-guardian",
  "version": "2.4.1",
  "description": "Reviews diffs for injection, secret-leak and authz regressions before merge.",
  "author": {
    "name": "AppSec Guild",
    "email": "appsec@devtools-engine.example.com"
  },
  "license": "Apache-2.0",
  "keywords": [
    "sast",
    "review"
  ],
  "agents": "./agents",
  "skills": "./skills",
  "commands": "./commands",
  "mcpServers": [
    "./.mcp.json",
    {
      "guardian-semgrep": {
        "command": "npx",
        "args": ["-y", "mcp-remote", "https://mcp.semgrep.ai/mcp"]
      },
      "guardian-taint-index": {
        "command": "python",
        "args": ["${CLAUDE_PLUGIN_ROOT}/servers/taint_index.py", "--stdio"],
        "env": {
          "TAINT_INDEX_CACHE": "${CLAUDE_PLUGIN_ROOT}/.cache"
        }
      }
    }
  ]
}
