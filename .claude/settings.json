{
  "enabledPlugins": {
    "code-guardian@devtools-engine-internal": true,
    "superpowers@devtools-engine-internal": true,
    "appstore-migrator@basf-appstore": true,
    "@acme/security-tools@acme-internal": true,
    "repo-refactor@devtools-engine-internal": false,
    "mem-palace@antigravity-labs": false
  },
  "model": "claude-sonnet-4-20250514",
  "permissions": {
    "allow_file_edit": true,
    "allow_terminal": true,
    "allow_web_search": false
  },
  "context": {
    "include_patterns": ["src/**", "infrastructure/**"],
    "exclude_patterns": ["**/node_modules/**", "**/__pycache__/**", "**/bin/**", "**/obj/**"]
  }
}
