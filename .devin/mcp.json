{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.3.15"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@0.6.0", "./src"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "code-search": {
      "command": "python",
      "args": ["mcp_servers/code_search_server.py", "--index-path", "./src"]
    }
  }
}
